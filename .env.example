# MomentBrand AI — Environment Variables Example
# Copy this file to .env and fill in your values.
APP_ENV=development
DEMO_FALLBACK_MODE=False

# ── Google Gemini (use ONE of the two options below) ──────────────────────────
#
# Option A — AI Studio API key (simpler, good for dev)
#   Get one at: https://aistudio.google.com/app/apikey
#   Key starts with "AIza..."
GOOGLE_AI_API_KEY=

# Option B — Google Cloud Service Account JSON key (Vertex AI, recommended for prod)
#   1. Create a service account in Google Cloud Console
#   2. Enable the "Vertex AI API" on your project
#   3. Download the JSON key and set the path below
GOOGLE_SERVICE_ACCOUNT_PATH=

# ── Cloudflare Workers AI ────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TEXT_MODEL_ID=@cf/moonshotai/kimi-k2.6
CLOUDFLARE_IMAGE_MODEL_ID=@cf/black-forest-labs/flux-2-klein-9b
CLOUDFLARE_IMAGE_EDIT_MODEL_ID=@cf/black-forest-labs/flux-2-klein-9b
# Legacy fallback for older deployments.
CLOUDFLARE_MODEL_ID=

# ── Remove.bg (product image background removal) ─────────────────────────────
# 50 free calls. If credits run out, images are uploaded without bg removal.
REMOVEBG_API_KEY=

# ── PostgreSQL + local uploads ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/momentbrand
UPLOADS_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8000

# ── Calendarific ─────────────────────────────────────────────────────────────
CALENDARIFIC_API_KEY=

# ── Kaggle TRIBE v2 brain-response API ───────────────────────────────────────
# Public ngrok URL from brain_response.ipynb, without a trailing slash.
BRAIN_API_BASE_URL=
BRAIN_API_TIMEOUT_SECONDS=180
